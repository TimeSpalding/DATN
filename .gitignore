# ==============================================================================
# HỆ THỐNG QUẢN LÝ CỬA HÀNG THỜI TRANG ĐA PHƯƠNG THỨC & THỬ ĐỒ ẢO
# Root .gitignore - Cấu hình bỏ qua tệp tin toàn dự án
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Hệ điều hành và tệp tạm hệ thống (OS & Temporary Files)
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.tmp
*.bak
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 2. Môi trường phát triển và cấu hình trình soạn thảo (IDEs & Editors)
# ------------------------------------------------------------------------------
# JetBrains (IntelliJ IDEA, PyCharm, WebStorm)
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Eclipse / Spring Tool Suite (STS)
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# ------------------------------------------------------------------------------
# 3. Biến môi trường và chứng chỉ bảo mật (Environment & Secrets)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
project_code.tar.gz

# ------------------------------------------------------------------------------
# 4. Frontend (Node.js / React / Vite)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
frontend/dist/
frontend/dist-ssr/
**/dist/
**/dist-ssr/
.eslintcache
.stylelintcache
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 5. Backend Java (Spring Boot / Maven / Gradle)
# ------------------------------------------------------------------------------
target/
**/target/
build/
**/build/
.gradle/
**/bin/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# ------------------------------------------------------------------------------
