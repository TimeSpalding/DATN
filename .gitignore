# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
venv/
**/venv/
.venv/
**/.venv/
env/
**/env/
ENV/
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------------------------
# 7. Mô hình AI, trọng số và bộ nhớ đệm (AI Models, Weights & Caches)
# ------------------------------------------------------------------------------
backend-ai/uploads/
backend-ai/models/
backend-ai/base_model_cache/
backend-ai/ocr_model_cache/
